# Mail transport. Credentials live here, never in site.config.ts — that file is committed
# to each client repo.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM=noreply@example.ch

# Alternative provider (set integrations.mailProvider to 'postmark-eu')
# POSTMARK_TOKEN=

# Build-time Google Business Profile review fetch (scripts/fetch-reviews.ts).
# Not required to build — the reviews page shows an empty state without it.
# GOOGLE_PLACES_API_KEY=
